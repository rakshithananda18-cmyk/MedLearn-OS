{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/web/node_modules/next/dist/bin/next",
        "start",
        "apps/web",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/web/node_modules/next/dist/bin/next",
        "dev",
        "apps/web",
        "--port",
        "3200"
      ],
      "port": 3200
    }
  ]
}
