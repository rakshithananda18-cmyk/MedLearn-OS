# Copied to apps/web/.env.local and .env.test.local by `pnpm bootstrap`,
# which fills the Supabase values from the local stack (`supabase status`).

# Supabase API URL (local stack default shown)
SUPABASE_URL=http://127.0.0.1:54321

# Supabase public (anon / publishable) key; row-level security applies to it
SUPABASE_ANON_KEY=

# debug | info | warn | error
LOG_LEVEL=info

# Comma-separated emails allowed to use the app. When set, everyone else is sent to the sign-in
# screen and cannot sign up. Leave empty for local development and tests (open to everyone).
# Set it wherever the app holds private content, such as study notes drawn from textbooks.
ACCESS_EMAILS=

# A production server with no ACCESS_EMAILS lets nobody in, so a forgotten list never publishes the
# notes. Set this to true only to run it open on purpose (the end-to-end tests and budgets do).
ACCESS_OPEN=
