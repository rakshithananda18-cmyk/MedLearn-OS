# Copied to apps/web/.env.local and .env.test.local by `pnpm bootstrap`,
# which fills the Supabase values from the local stack (`supabase status`).

# Supabase API URL (local stack default shown)
SUPABASE_URL=http://127.0.0.1:54321

# Supabase public (anon / publishable) key; row-level security applies to it
SUPABASE_ANON_KEY=

# debug | info | warn | error
LOG_LEVEL=info
